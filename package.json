{
  "name": "swarden",
  "private": true,
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start:server": "npm start -w server",
    "start:web": "npm run build -w web && npm run preview -w web",

    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",

    "test": "npm run test:server && npm run test:web",
    "test:server": "npm test -w server",
    "test:web": "npm run test --if-present -w web",

    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "npm run typecheck -w server",
    "typecheck:web": "npm run typecheck -w web",

    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7"
  }
}
